    },
    {
      "Id": "0kdbm000001VNqgAAG",
      "FormulaExpression": "IF(columns:Data_Type__c == \"button\",true,\"\")",
      "FormulaResultPath": "columns:typeAttributeDisabled"
    },
    {
      "Id": "0kdbm000001VNqhAAG",
      "FormulaExpression": "IF(isViewAll == \"VIEWALL\",true,section:Show_Pagination__c)",
      "FormulaResultPath": "section:Show_Pagination__c"
    },
    {
      "Id": "0kdbm000001VNqiAAG",
      "FormulaExpression": "IF(isViewAll == \"VIEWALL\",false,section:Show_ViewAll__c)",
      "FormulaResultPath": "section:Show_ViewAll__c"
    },
    {
      "Id": "0kdbm000001VNqjAAG",
      "FormulaExpression": "IF(isViewAll == \"VIEWALL\",50,section:Record_Limit_Per_Page__c)",
      "FormulaResultPath": "section:Record_Limit_Per_Page__c"
    },
    {
      "Id": "0kdbm000001VNqkAAG",
      "FormulaExpression": "IF(isViewAll == \"VIEWALL\",200,10)",
      "FormulaResultPath": "section:APIRecordLimit"
    },
    {
      "Id": "0kdbm000001VNqlAAG",
      "FormulaExpression": "IF((columns:Data_Type__c == \"date\" OR columns:Data_Type__c == \"date-local\"),\"2-digit\",\"\")",
